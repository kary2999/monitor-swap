# Hermes 家目录（脚本根路径，默认 ~/.hermes）
HERMES_HOME=/Users/you/.hermes

# 境外源代理（cron 环境不继承 shell 代理，脚本会自注入）
HERMES_HTTP_PROXY=http://127.0.0.1:7890

# ---- Lark / 飞书（send_lark_intel_post.py / archive_hourly_intel.py）----
LARK_APP_ID=
LARK_APP_SECRET=
LARK_CHAT_ID=

# ---- 归档目标（飞书云文档 + 多维表格）----
FEISHU_DOC_TOKEN=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=

# ---- 资讯中文化模型（translate_crypto_news.py）----
# 注意：脚本会硬校验 model 与 reasoning 值，换模型须同步改代码
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ⚠️ 以上全部为占位符，切勿提交真实值。.env 已在 .gitignore 中忽略。
